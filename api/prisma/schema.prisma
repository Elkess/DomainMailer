generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  FAILED
}

enum LeadStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
}

enum GmailAccountStatus {
  ACTIVE
  DISCONNECTED
  RATE_LIMITED
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  gmailAccounts GmailAccount[]
  campaigns    Campaign[]
  leads        Lead[]
  emailLogs    EmailLog[]
  queueJobs    QueueJob[]
  auditLogs    AuditLog[]

  @@map("users")
}

model GmailAccount {
  id                   String             @id @default(uuid())
  userId               String
  email                String
  refreshTokenEncrypted String
  accessTokenEncrypted String?
  accessTokenExpiresAt DateTime?
  status               GmailAccountStatus @default(ACTIVE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns            Campaign[]
  emailLogs            EmailLog[]

  @@index([userId, status])
  @@unique([userId, email])
  @@map("gmail_accounts")
}

model Campaign {
  id                String         @id @default(uuid())
  userId            String
  gmailAccountId    String
  name              String
  subjectTemplate   String
  bodyTemplate      String
  requiredVariables Json
  dailyLimit        Int
  delayMinSeconds   Int
  delayMaxSeconds   Int
  startTime         DateTime?
  status            CampaignStatus @default(DRAFT)
  failureCount      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailAccount      GmailAccount   @relation(fields: [gmailAccountId], references: [id], onDelete: Restrict)
  leads             Lead[]
  emailLogs         EmailLog[]
  queueJobs         QueueJob[]

  @@index([userId, status])
  @@map("campaigns")
}

model Lead {
  id            String     @id @default(uuid())
  userId        String
  campaignId    String
  companyName   String
  domainName    String
  firstName     String
  email         String
  customFields  Json
  status        LeadStatus @default(PENDING)
  attemptCount  Int        @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign      Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  emailLogs     EmailLog[]

  @@index([userId, campaignId, status])
  @@map("leads")
}

model EmailLog {
  id             String    @id @default(uuid())
  userId         String
  campaignId     String
  leadId         String
  gmailAccountId String
  status         String
  providerCode   String?
  providerBody   String?
  errorMessage   String?
  bounceStatus   String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  gmailAccount   GmailAccount @relation(fields: [gmailAccountId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("email_logs")
}

model QueueJob {
  id          String   @id @default(uuid())
  userId      String
  campaignId  String
  queueName   String
  jobId       String
  status      String
  payload     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId, campaignId, status])
  @@map("queue_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  resourceId String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
