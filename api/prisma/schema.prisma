generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id     String
  action      String
  resource    String
  resource_id String?
  metadata    Json?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model campaign_notifications {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaign_id String   @db.Uuid
  user_id     String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([created_at(sort: Desc)], map: "idx_campaign_notifications_created")
}

model campaigns {
  id                     String          @id
  user_id                String
  gmail_account_id       String
  name                   String
  subject_template       String
  body_template          String
  required_variables     Json?           @default("[]")
  daily_limit            Int
  delay_min_seconds      Int
  delay_max_seconds      Int
  start_time             DateTime?       @db.Timestamptz(6)
  status                 CampaignStatus? @default(DRAFT)
  failure_count          Int?            @default(0)
  follow_up2_body        String?
  follow_up2_delay_hours Int?            @default(72)
  follow_up3_body        String?
  follow_up3_delay_hours Int?            @default(72)
  follow_up4_body        String?
  follow_up4_delay_hours Int?            @default(72)
  created_at             DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?       @default(now()) @db.Timestamptz(6)
  gmail_accounts         gmail_accounts  @relation(fields: [gmail_account_id], references: [id], onUpdate: NoAction)
  users                  users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  email_logs             email_logs[]
  leads                  leads[]
  queue_jobs             queue_jobs[]

  @@index([user_id, status], map: "idx_campaigns_user_status")
}

model email_logs {
  id               String         @id
  user_id          String
  campaign_id      String
  lead_id          String
  gmail_account_id String
  subject          String
  body             String
  sent_at          DateTime?      @default(now()) @db.Timestamptz(6)
  status           String?
  error_message    String?
  bounce_status    String?
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  sequence_step    Int?           @default(1)
  campaigns        campaigns      @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gmail_accounts   gmail_accounts @relation(fields: [gmail_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads            leads          @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users            users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at], map: "idx_email_logs_user_created")
}

model gmail_accounts {
  id                      String              @id
  user_id                 String
  email                   String
  refresh_token_encrypted String
  access_token_encrypted  String?
  access_token_expires_at DateTime?           @db.Timestamptz(6)
  status                  GmailAccountStatus? @default(ACTIVE)
  created_at              DateTime?           @default(now()) @db.Timestamptz(6)
  campaigns               campaigns[]
  email_logs              email_logs[]
  users                   users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leads                   leads[]
}

model leads {
  id               String          @id
  user_id          String
  campaign_id      String
  gmail_account_id String?
  email            String
  first_name       String?         @default("")
  company_name     String?         @default("")
  domain_name      String?         @default("")
  custom_fields    Json?           @default("{}")
  status           LeadStatus?     @default(PENDING)
  sent_at          DateTime?       @db.Timestamptz(6)
  opened_at        DateTime?       @db.Timestamptz(6)
  clicked_at       DateTime?       @db.Timestamptz(6)
  replied_at       DateTime?       @db.Timestamptz(6)
  bounced_at       DateTime?       @db.Timestamptz(6)
  error_message    String?
  created_at       DateTime?       @default(now()) @db.Timestamptz(6)
  email_logs       email_logs[]
  campaigns        campaigns       @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gmail_accounts   gmail_accounts? @relation(fields: [gmail_account_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users            users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  queue_jobs       queue_jobs[]

  @@unique([campaign_id, email])
  @@index([campaign_id, status], map: "idx_leads_campaign_status")
  @@index([user_id, created_at], map: "idx_leads_user_created")
}

model queue_jobs {
  id            String    @id
  user_id       String
  campaign_id   String
  lead_id       String
  scheduled_for DateTime  @db.Timestamptz(6)
  status        String?   @default("pending")
  attempts      Int?      @default(0)
  last_error    String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  campaigns     campaigns @relation(fields: [campaign_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leads         leads     @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scheduled_for, status], map: "idx_queue_jobs_scheduled")
}

model users {
  id             String           @id
  email          String           @unique
  password_hash  String
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  audit_logs     audit_logs[]
  campaigns      campaigns[]
  email_logs     email_logs[]
  gmail_accounts gmail_accounts[]
  leads          leads[]
  queue_jobs     queue_jobs[]
}

model notifications {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id     String
  campaign_id String
  timestamp   BigInt
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([timestamp], map: "idx_notifications_timestamp")
  @@index([user_id, campaign_id], map: "idx_notifications_user_campaign")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

enum GmailAccountStatus {
  ACTIVE
  REVOKED
  ERROR
}

enum LeadStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
}
